{
  "name": "auditoria-cash",
  "productName": "Auditoría Cash",
  "version": "0.1.0",
  "private": true,
  "description": "Auditoría de facturas Cashea y comunes",
  "author": "Novedades y Textiles Yessica",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on tcp:5173 && node scripts/iniciar.cjs --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/iniciar.cjs",
    "clave-temporal": "node scripts/clave-temporal.cjs",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.textilesyessica.auditoriacash",
    "productName": "Auditoria Cash",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build/config.dist.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auditoria Cash"
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.69.0",
    "mssql": "^12.7.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
